<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<VBox alignment="CENTER" spacing="20.0" style="-fx-background-color: #2C3E50;" 
      xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.mycompany.jogo.controller.PrimaryController">
   <children>
      <ImageView fx:id="imagemTitulo" fitWidth="400" preserveRatio="true" 
           VBox.vgrow="ALWAYS">
    <image>
        <Image url="@titulo.png" />
    </image>
    </ImageView>
      
      <Button text="Jogar" onAction="#irParaGameplay" prefWidth="200" style="-fx-background-color: #E67E22; -fx-text-fill: white;" />
      
      <Button text="Ranking" onAction="#irParaRanking" prefWidth="200" style="-fx-background-color: #3498DB; -fx-text-fill: white;" />
      
      <Button text="Upgrades" onAction="#irParaUpgrades" prefWidth="200" style="-fx-background-color: #9B59B6; -fx-text-fill: white;" />
      
      <Button text="Creditos" onAction="#irParaCreditos" prefWidth="200" style="-fx-background-color: #1ABC9C; -fx-text-fill: white;" />
      
      <Button text="Encerrar" onAction="#encerrar" prefWidth="200" style="-fx-background-color: #C0392B; -fx-text-fill: white;" />
   </children>
   <padding><Insets bottom="30.0" left="30.0" right="30.0" top="30.0" /></padding>
</VBox>