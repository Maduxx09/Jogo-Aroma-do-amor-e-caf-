<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<VBox alignment="CENTER" spacing="15.0" style="-fx-background-color: #17202A;" 
      xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.mycompany.jogo.controller.CreditosController">
  
    <children>
      <Label text="Créditos" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #F1C40F;" />
      
      <Label text="Jogo: Aroma de Amor e Café" style="-fx-font-size: 18px; -fx-text-fill: #ECF0F1;" />
      
      <Label text="Desenvolvido por: " style="-fx-font-size: 16px; -fx-text-fill: #BDC3C7;" />
      
      <Label text="Isabelli Melgarejo e Maria Eduarda Marques" style="-fx-font-size: 16px; -fx-text-fill: #FFFFFF;" />
      
      <Label text="Disciplina: Tópicos em Linguagem de Programação 2" style="-fx-font-size: 14px; -fx-text-fill: #BDC3C7;" />
      
      <Label text="Tecnologias: Java, JavaFX, FXML, PostgreSQL, JDBC" style="-fx-font-size: 14px; -fx-text-fill: #BDC3C7;" />
      
      <Button text="Voltar ao Menu" onAction="#voltar" prefWidth="200" style="-fx-background-color: #F1C40F; -fx-text-fill: black;" />
   </children>
   
   <padding><Insets bottom="30.0" left="30.0" right="30.0" top="30.0" /></padding>
