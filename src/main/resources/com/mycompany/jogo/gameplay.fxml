<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<VBox alignment="CENTER" spacing="20.0" style="-fx-background-color: #FDF2E9;" 
      xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.mycompany.jogo.controller.GameplayController">
    
   <children>
      <Label text="Turno para um Café" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #6E2C00;" />
      
      <HBox alignment="CENTER" spacing="40.0">
          
         <Label fx:id="dias" text="Dia: 1" style="-fx-font-size: 18px;" />
         <Label fx:id="moedin" text="Moedas: 0" style="-fx-font-size: 18px; -fx-text-fill: #F39C12;" />
         
      </HBox>
      
      <Label text="Cliente faz um pedido" style="-fx-font-size: 16px; -fx-text-fill: #7F8C8D;" />
      
      <Button text="Preparar Pedido" onAction="#prepararPedido" 
              prefWidth="200" style="-fx-background-color: #E67E22; -fx-text-fill: white;" />
      <Button text="Finalizar Turno" onAction="#finalizarTurno" 
              prefWidth="200" style="-fx-background-color: #27AE60; -fx-text-fill: white;" />
      
      <Button text="Voltar ao Menu" onAction="#voltar" prefWidth="200" />
      
   </children>
   
   <padding><Insets bottom="30.0" left="30.0" right="30.0" top="30.0" /></padding>
</VBox>